{
  "identifier": "default",
  "description": "wqq-float 全部窗口的权限（悬浮窗与设置窗共用）",
  "windows": ["float", "settings"],
  "permissions": [
    "core:default",
    "core:event:default",
    "core:window:allow-start-dragging",
    "opener:default",
    "autostart:allow-enable",
    "autostart:allow-disable",
    "autostart:allow-is-enabled"
  ]
}
